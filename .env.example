PORT=3000
NODE_ENV=production

# ---------------------------------------------------------------------------
# OBLIGATORIAS — sin estas el servicio arranca pero no funciona
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...

# Bubble — URL del endpoint de búsqueda de propiedades.
# Ojo: /version-test/ apunta a la base de DESARROLLO, sin eso va a producción.
BUBBLE_SEARCH_URL=https://tu-app.bubbleapps.io/version-test/api/1.1/wf/buscarpropiedades

# Mapbox — geocodificación de zonas y reverse geocoding del GPS del usuario
MAPBOX_ACCESS_TOKEN=pk....

# ---------------------------------------------------------------------------
# OPCIONALES — todas tienen valor por defecto, solo defínelas para cambiarlo
# ---------------------------------------------------------------------------

# Formato de Ciudad/Estado/Colonia hacia Bubble, según cómo esté armado el
# constraint del workflow:
#   json  -> ["Monterrey"]          (default)
#   plain -> Monterrey
#   csv   -> Monterrey,San Pedro
BUBBLE_ADMIN_FORMAT=json

# Volcado del payload de Bubble a Cloud Storage para diagnóstico.
#   on-error -> solo cuando falla el parseo (default)
#   always   -> todas las respuestas (llena el bucket rápido)
#   off      -> desactivado
DEBUG_DUMP_MODE=on-error
GCS_BUCKET_NAME=dotcasa-fotos-prod
DEBUG_DUMP_PREFIX=debug-bubble-json

# Nota: GCS NO usa una variable de credenciales. En Cloud Run se autentica con
# la service account del servicio, que necesita roles/storage.objectCreator
# sobre el bucket.
